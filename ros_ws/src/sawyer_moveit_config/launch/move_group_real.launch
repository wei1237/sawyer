<?xml version="1.0"?>
<launch>
  <arg name="debug" default="false" />
  <arg unless="$(arg debug)" name="launch_prefix" value="" />
  <arg if="$(arg debug)" name="launch_prefix" value="gdb --ex run --args" />

  <arg name="pipeline" default="ompl" />
  <arg name="load_robot_description" default="true" />
  <arg name="pedestal" default="true" />
  <arg name="electric_gripper" default="true" />
  <arg name="moveit_controller_manager" default="moveit_simple_controller_manager/MoveItSimpleControllerManager" />
  <arg name="controllers_file" default="$(find sawyer_moveit_config)/config/controllers_real.yaml" />
  <arg name="publish_monitored_planning_scene" default="true" />

  <param if="$(arg load_robot_description)"
         name="robot_description"
         command="$(find xacro)/xacro --inorder $(find sawyer_description)/urdf/sawyer.urdf.xacro gazebo:=false pedestal:=$(arg pedestal) electric_gripper:=$(arg electric_gripper)" />

  <include file="$(dirname)/planning_context.launch">
    <arg name="load_robot_description" value="false" />
  </include>

  <group ns="move_group/planning_pipelines">
    <include file="$(dirname)/planning_pipeline.launch.xml">
      <arg name="pipeline" value="ompl" />
    </include>
    <include file="$(dirname)/planning_pipeline.launch.xml">
      <arg name="pipeline" value="chomp" />
    </include>
    <include file="$(dirname)/planning_pipeline.launch.xml">
      <arg name="pipeline" value="pilz_industrial_motion_planner" />
    </include>
  </group>

  <include ns="move_group" file="$(dirname)/trajectory_execution_real.launch.xml">
    <arg name="moveit_controller_manager" value="$(arg moveit_controller_manager)" />
    <arg name="controllers_file" value="$(arg controllers_file)" />
    <arg name="moveit_manage_controllers" value="false" />
  </include>

  <include ns="move_group" file="$(dirname)/sensor_manager.launch.xml">
    <arg name="moveit_sensor_manager" value="sawyer" />
  </include>

  <node name="move_group" launch-prefix="$(arg launch_prefix)" pkg="moveit_ros_move_group" type="move_group" respawn="false" output="screen">
    <param name="moveit_controller_manager" value="$(arg moveit_controller_manager)" />
    <rosparam file="$(arg controllers_file)" command="load" />
    <param name="default_planning_pipeline" value="$(arg pipeline)" />
    <param name="planning_pipelines/ompl/planning_plugin" value="ompl_interface/OMPLPlanner" />
    <param name="monitor_dynamics" value="false" />
    <param name="planning_scene_monitor/publish_planning_scene" value="$(arg publish_monitored_planning_scene)" />
    <param name="planning_scene_monitor/publish_geometry_updates" value="$(arg publish_monitored_planning_scene)" />
    <param name="planning_scene_monitor/publish_state_updates" value="$(arg publish_monitored_planning_scene)" />
    <param name="planning_scene_monitor/publish_transforms_updates" value="$(arg publish_monitored_planning_scene)" />
  </node>
</launch>
