<?xml version="1.0"?>
<sdf version="1.6">
  <model name="green_cylinder">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="link">
      <!-- Upright tall cylinder for side-grasp demos:
           diameter 4.4cm, height 16.0cm.
           Diameter is kept within the Sawyer electric gripper opening. -->
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <!-- Solid cylinder inertia for m=0.12, r=0.022, h=0.160 -->
          <ixx>0.00027052</ixx>
          <iyy>0.00027052</iyy>
          <izz>0.00002904</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.022</radius>
            <length>0.160</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>1</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.022</radius>
            <length>0.160</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 0.85 0 1</diffuse>
          <specular>0.05 0.1 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
