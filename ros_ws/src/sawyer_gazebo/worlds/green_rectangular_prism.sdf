<?xml version="1.0"?>
<sdf version="1.6">
  <model name="green_rectangular_prism">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="link">
      <!-- Dimensions: length x width x height = 3cm x 10cm x 3.5cm.
           The narrow side is gripper-friendly; the long side tests yaw alignment. -->
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <!-- Box inertia for m=0.08, x=0.03, y=0.10, z=0.035 -->
          <ixx>0.00007417</ixx>
          <iyy>0.00001417</iyy>
          <izz>0.00007267</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.03 0.10 0.035</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>1</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.03 0.10 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 0.85 0 1</diffuse>
          <specular>0.05 0.1 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
