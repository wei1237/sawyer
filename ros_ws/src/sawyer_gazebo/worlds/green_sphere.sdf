<?xml version="1.0"?>
<sdf version="1.6">
  <model name="green_sphere">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="link">
      <!-- Sphere radius 2.5cm, diameter 5.0cm. -->
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <!-- Solid sphere inertia: 2/5*m*r^2, m=0.05, r=0.025 -->
          <ixx>0.0000125</ixx>
          <iyy>0.0000125</iyy>
          <izz>0.0000125</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- High-friction rubber-like sphere for stable parallel-gripper grasping. -->
              <mu>5.0</mu>
              <mu2>5.0</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>10</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 0.85 0 1</diffuse>
          <specular>0.05 0.1 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
