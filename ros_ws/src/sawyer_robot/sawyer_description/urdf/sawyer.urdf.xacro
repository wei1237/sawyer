<?xml version="1.0" ?>
<robot name="sawyer" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="gazebo" default="false"/>
  <xacro:arg name="pedestal" default="true"/>
  <xacro:arg name="static" default="true"/>
  <xacro:arg name="electric_gripper" default="false"/>
  <!-- Sawyer Base URDF -->
  <xacro:include filename="$(find sawyer_description)/urdf/sawyer_base.urdf.xacro">
    <xacro:arg name="gazebo" value="${gazebo}"/>
    <xacro:arg name="pedestal" value="${pedestal}"/>
  </xacro:include>
  <xacro:if value="$(arg gazebo)">
    <xacro:include filename="$(find sawyer_description)/urdf/sawyer_base.gazebo.xacro">
      <xacro:arg name="static" value="${static}"/>
      <xacro:arg name="pedestal" value="${pedestal}"/>
    </xacro:include>
  </xacro:if>
  <!-- Electric Gripper End Effector -->
  <xacro:if value="$(arg electric_gripper)">
    <xacro:include filename="$(find sawyer_description)/urdf/sawyer_electric_gripper.urdf.xacro">
      <xacro:arg name="gazebo" value="${gazebo}"/>
    </xacro:include>
  </xacro:if>

  <!-- 🌟 修复：Gazebo模式下禁用右臂所有link重力（含夹爪） -->
  <xacro:if value="$(arg gazebo)">
    <!-- 宏定义：批量禁用link重力 -->
    <xacro:macro name="disable_arm_gravity" params="link_name">
      <gazebo reference="${link_name}">
        <gravity>false</gravity> <!-- 核心：禁用该link的重力 -->
        <static>false</static>    <!-- 确保机械臂可运动，不固定 -->
      </gazebo>
    </xacro:macro>

    <!-- 1. 机械臂关节link（匹配frames.pdf中的实际名称） -->
    <xacro:disable_arm_gravity link_name="right_l0"/>
    <xacro:disable_arm_gravity link_name="right_l1"/>
    <xacro:disable_arm_gravity link_name="right_l2"/>
    <xacro:disable_arm_gravity link_name="right_l3"/>
    <xacro:disable_arm_gravity link_name="right_l4"/>
    <xacro:disable_arm_gravity link_name="right_l5"/>
    <xacro:disable_arm_gravity link_name="right_l6"/>
    <!-- 2. 电动夹爪link（匹配frames.pdf中的实际名称） -->
    <xacro:disable_arm_gravity link_name="right_gripper_base"/>
    <xacro:disable_arm_gravity link_name="right_gripper_l_finger"/>
    <xacro:disable_arm_gravity link_name="right_gripper_r_finger"/>
    <xacro:disable_arm_gravity link_name="right_gripper_tip"/> <!-- 已删除多余的"f>" -->
  </xacro:if>

</robot>
